{
  "description": "agent-trap-scan: flag risky text aimed at AI agents in repositories you open, clone or read",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 30,
            "statusMessage": "Scanning this repository for agent traps"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(//**/AGENTS.md)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/AGENT.md)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/CLAUDE.md)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/CLAUDE.local.md)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
