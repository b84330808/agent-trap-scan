            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/CONTRIBUTING*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/contributing*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/agent-trap-scan/scripts/agent-trap-scan.mjs\" hook",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Read(//**/AI_POLICY*)",
